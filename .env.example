# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Required ---

# OpenAI API key used by the OpenAI Agents SDK (chat agent, prospecting,
# research, web search tool).
OPENAI_API_KEY=

# --- Database (Milestone 3E — Vercel Postgres / Neon) ---
#
# Unlike the earlier SQLite/Turso attempt, Postgres has no local-file mode.
# Local development ALSO needs a real connection string here — either a
# free Neon database (https://neon.tech, or via Vercel's Storage tab,
# which provisions the same thing without needing to visit neon.tech
# directly) or a local Postgres install.
#
# Get this from Vercel: Project → Storage → your Postgres/Neon database →
# ".env.local" tab (copies all of these for you), or from the Neon console
# directly under Connect → Connection string.
DATABASE_URL=

# --- Access gating (Milestone 3G) ---
#
# Sets a single shared password gating the human-facing app (dashboard,
# prospects, settings, etc.) — not a multi-user login, just a lock on the
# front door. Leave unset to leave the app ungated (e.g. for local dev).
# Does NOT affect /api/cron/* (uses CRON_SECRET instead) or the public
# /unsubscribe/[token] page.
APP_PASSWORD=

# --- Upstash QStash (Milestone 3I) — genuine 24/7 ticking ---
#
# Optional, but needed for the engine to make progress when nobody has
# the app open and it's not cron's once-a-day window. Get these from your
# Upstash console after creating a QStash schedule targeting
# https://your-app.vercel.app/api/tasks/tick (see the setup guide for how
# to create the schedule itself — these two values just let this app
# verify a request genuinely came from QStash).
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- IMAP (Milestone 3J) — inbound replies and bounces ---
#
# Same mailbox as your SMTP sending config, read via IMAP (the protocol
# your phone's Mail app uses) so the agent can see replies and bounces.
# For a typical hosting-provider mailbox like this one, IMAP_HOST is the
# same as SMTP_HOST, and IMAP_USER/IMAP_PASSWORD are the same as
# SMTP_USER/SMTP_PASSWORD.
IMAP_HOST=mail.prfed.com
IMAP_PORT=993
IMAP_USER=patterns@prfed.com
IMAP_PASSWORD=
IMAP_SECURE=true

# --- Vercel Cron (Milestone 3E) ---
#
# Optional but recommended in production. Vercel automatically sends this
# as a Bearer token on requests to cron-triggered routes
# (see vercel.json + src/app/api/cron/daily/route.ts). If unset, the cron
# route's auth check is skipped — fine for local testing, not recommended
# once deployed.
CRON_SECRET=

# --- Search (used by some research/prospecting paths) ---
SEARCH_PROVIDER=
SEARCH_API_KEY=
GOOGLE_CSE_ID=

# --- Outbound email config ---
#
# NOTE: these configure SMTP delivery settings only. As of this writing,
# no code path in this repository actually sends email — the prospecting
# executor (src/lib/taskEngine/executors/prospecting.ts) is explicitly
# research-only and never contacts prospects. These variables exist for a
# planned outreach capability; treat adding real send logic as a separate,
# deliberate decision, not something to build incidentally.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=

# Comma-separated list of addresses that get a BCC copy of every outbound
# campaign email — your own personal record of what was actually sent.
BCC_NOTIFICATION_EMAILS=
SENDER_POSTAL_ADDRESS=

# --- Book / outreach content context ---
BOOK_TITLE=
BOOK_SALES_PAGE_URL=
BOOK_AMAZON_URL=

# --- Planned outreach guardrails (not yet enforced by any code path) ---
DAILY_SEND_LIMIT=
MIN_SECONDS_BETWEEN_SENDS=
REQUIRE_MANUAL_APPROVAL=

# --- Misc ---
APP_BASE_URL=
WORKER_POLL_INTERVAL_MS=

# Legacy/unused: superseded by TURSO_DATABASE_URL above. Not read by any
# current code path.
DATABASE_PATH=
