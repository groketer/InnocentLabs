# ============================================================================
# InnocentLabs configuration
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.
# ============================================================================

# --- OpenAI (powers the discovery + copywriting agents) -------------------
OPENAI_API_KEY=
# --- Web search provider (used by the prospect discovery agent) -----------
# InnocentLabs needs a search API to find public pages. Any one of these
# works — set SEARCH_PROVIDER to match the key you provide.
# Options: "serpapi" | "google_cse" | "bing"
SEARCH_PROVIDER=serpapi
SEARCH_API_KEY=
GOOGLE_CSE_ID=

# --- Outbound email (SMTP) -------------------------------------------------
SMTP_HOST=mail.prfed.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=patterns@prfed.com
SMTP_PASSWORD=
# What recipients see in the From header
SMTP_FROM_NAME=Patterns of Opportunity

# --- CAN-SPAM compliance ----------------------------------------------------
# A physical postal address is legally required in every marketing email.
SENDER_POSTAL_ADDRESS="InnocentLabs / InnocentLabs Ltd, Innocent Mwangi Residence, Kiambu, Kenya 254"

# --- Book / product being marketed -----------------------------------------
BOOK_TITLE="Patterns of Opportunity: Seeing What Others Overlook"
BOOK_SALES_PAGE_URL=https://books.prfed.com/patterns/
BOOK_AMAZON_URL=https://www.amazon.com/dp/B0HGVNBNBX

# --- Sending controls --------------------------------------------------------
# Max emails sent per 24h across all campaigns.
DAILY_SEND_LIMIT=100
# Minimum seconds between individual sends (paces sending across the day).
MIN_SECONDS_BETWEEN_SENDS=45
# If true, newly discovered prospects sit in "discovered" status and a human
# must approve them in the dashboard before they become eligible to email.
# Strongly recommended to leave this "true" — consent signals detected by
# the discovery agent are heuristic, not certain.
REQUIRE_MANUAL_APPROVAL=true

# --- App / worker ------------------------------------------------------------
# Base URL the app is served at locally (used to build unsubscribe links).
APP_BASE_URL=http://localhost:3000
# How often the worker polls the task queue, in milliseconds.
WORKER_POLL_INTERVAL_MS=15000
# Path to the SQLite database file.
DATABASE_PATH=./data/innocentlabs.db
